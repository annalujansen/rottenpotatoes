%p{style: "color: green"}= notice
- if flash[:warning]
  %p#warning{style: "color: red"}= flash[:warning]

- content_for :title, "Movies"

%h1 Movies

%table#movies
  %thead
    %tr
      %th{class: ("highlight" if @sort == "title")}
        = link_to "Movie Title", movies_path(sort: "title"), id: :title_header      
      %th Classificação
      %th{class: ("highlight" if @sort == "release_date")}
        = link_to "Lançamento", movies_path(sort: "release_date"), id: :release_date_header      
      %th Detalhes

  %tbody
    - @movies.each do |movie|
      %tr
        %td{class: ("highlight" if @sort == "title")}= movie.title        
        %td= movie.rating
        %td{class: ("highlight" if @sort == "release_date")}= movie.release_date        
        %td= link_to "Ver detalhes", movie_path(movie)

= link_to "Add new movie", new_movie_path

%h2 Search TMDb for a movie

= form_tag search_tmdb_path, id: "search_tmdb_form" do
  = label_tag :search_terms, "Search Terms"
  = text_field_tag :search_terms
  = submit_tag "Search TMDb"