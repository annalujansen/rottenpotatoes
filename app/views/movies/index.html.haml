%p{style: "color: green"}= notice

- content_for :title, "Movies"

%h1 Movies

%table
  %thead
    %tr
      %th= link_to "Título", movies_path(sort: "title"), id: :title_header
      %th Classificação
      %th= link_to "Lançamento", movies_path(sort: "release_date"), id: :release_date_header
      %th Detalhes

  %tbody
    - @movies.each do |movie|
      %tr
        %td= movie.title
        %td= movie.rating
        %td= movie.release_date
        %td= link_to "Ver detalhes", movie_path(movie)

= link_to "Novo filme", new_movie_path

%th= link_to "Título", movies_path(sort: "title")
%th Classificação
%th= link_to "Lançamento", movies_path(sort: "release_date")